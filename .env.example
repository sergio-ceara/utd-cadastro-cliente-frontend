From dd047f2151ee12ea329e28bb6ccef397dee2fbdd Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?S=C3=A9rgio=20Sousa?= <sergio.ceara.programacao@gmail.com>
Date: Thu, 27 Aug 2026 15:34:12 +0000
Subject: [PATCH] =?UTF-8?q?Remove=20.env=20do=20controle=20de=20vers=C3=A3?=
 =?UTF-8?q?o=20e=20adiciona=20.env.example?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

O .env continha valores reais de configuração (URLs) e não estava
listado no .gitignore. Agora ele deixa de ser versionado, o .gitignore
passa a ignorar .env/.env.local, e um .env.example (com placeholders)
fica no lugar como modelo.
---
 .env         | 2 --
 .env.example | 8 ++++++++
 .gitignore   | 5 +++++
 3 files changed, 13 insertions(+), 2 deletions(-)
 delete mode 100644 .env
 create mode 100644 .env.example

diff --git a/.env b/.env
deleted file mode 100644
index 43e9e4a..0000000
--- a/.env
+++ /dev/null
@@ -1,2 +0,0 @@
-VITE_NEXT_PUBLIC_BASE_FRONT=http://localhost:5173
-VITE_API_BASE_URL=https://utdcadastro-clientebackend-production.up.railway.app/api
diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000..e32a090
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,8 @@
+# Copie este arquivo para '.env' e preencha os valores reais do seu ambiente.
+# Este arquivo (.env.example) é apenas um modelo e não deve conter valores reais.
+
+# URL base do frontend (Vite)
+VITE_NEXT_PUBLIC_BASE_FRONT=http://localhost:5173
+
+# URL base da API do backend
+VITE_API_BASE_URL=https://sua-api.exemplo.com/api
diff --git a/.gitignore b/.gitignore
index a547bf3..2d1f044 100644
--- a/.gitignore
+++ b/.gitignore
@@ -22,3 +22,8 @@ dist-ssr
 *.njsproj
 *.sln
 *.sw?
+
+# Environment variables
+.env
+.env.local
+.env.*.local
-- 
2.43.0
